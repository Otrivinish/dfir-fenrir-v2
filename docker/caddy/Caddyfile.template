# DFIR-FENRIR v2 — edge Caddyfile. THE single source of truth for Caddy config.
#
# Installed as /etc/caddy/Caddyfile and read directly by `caddy run`; nothing is
# generated at runtime (the root filesystem is read-only). docker/caddy/entrypoint.sh
# only picks the TLS mode and exports the {$FENRIR_*} environment placeholders
# below, which Caddy substitutes BEFORE parsing — so they may hold whole
# multi-line blocks (see caddyserver.com/docs/caddyfile/concepts#environment-variables).

{
	{$FENRIR_GLOBAL_EMAIL}
	# No runtime admin API: the config never changes without a container restart.
	admin off
	# Non-root Caddy cannot (and must not) edit the system trust store in `tls internal` mode.
	skip_install_trust
	# Clients that connect by IP send no SNI — serve them the site's certificate.
	default_sni {$DOMAIN:localhost}
	# Caddy's own log (stderr, JSON as before). A one-time link carries its secret in the query string
	# (…/working-copies/{id}/download?token=…; owner decision 2026-10-04): an error logged with the
	# request (e.g. the backend cutting a download short) would print it, so the `token` query
	# parameter is deleted from request>uri here too (the site's access log below does the same).
	log default {
		output stderr
		format filter {
			wrap json
			request>uri query {
				delete token
			}
		}
	}
	servers {
		# HTTP/3 needs UDP 443, which is not published — don't advertise it.
		protocols h1 h2
		# The backend runs ONE uvicorn worker: cut slow-header (slowloris) clients fast,
		# but leave room for multi-GiB evidence/collection uploads and export downloads.
		timeouts {
			read_header 10s
			read_body 30m
			write 30m
			idle 2m
		}
	}
}

# ─── Shared security headers ────────────────────────────────────────────────
(security_baseline) {
	header {
		# 1 year, subdomains. No `preload`: only add it for a public domain you
		# actually submit to hstspreload.org.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Legacy clickjacking guard — superseded by CSP frame-ancestors, kept for old UAs.
		X-Frame-Options "DENY"
		# The legacy XSS auditor is itself exploitable; OWASP recommends disabling it.
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()"
		-Server
	}
}

# FastAPI's Swagger UI + ReDoc (admin-only). Assets are self-hosted under
# /api/_static/; 'unsafe-inline' stays because the FastAPI helpers emit inline
# <script>/<style>. frame-ancestors 'self' — the admin SPA iframes /api/docs.
(csp_api_docs) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
}

# Upstream transport to the backend: TLS verified against the internal CA, with
# Caddy's client certificate — the backend requires it (mutual TLS), so nothing but
# Caddy can talk to it, whatever its network position.
(backend_mtls) {
	# For an https upstream Caddy would send Host: backend — keep the client's Host so
	# the backend's TrustedHost check (ALLOWED_HOSTS) still sees the public name.
	header_up Host {host}
	transport http {
		tls_trust_pool file /run/secrets/tls_ca_crt
		tls_client_auth /run/secrets/tls_caddy_crt /run/secrets/tls_caddy_key
		tls_server_name backend
	}
}

{$FENRIR_SITE_ADDR} {
	{$FENRIR_TLS_BLOCK}

	import security_baseline

	# SPA CSP — no CDNs, no remote scripts. 'unsafe-inline' on style-src only (React/
	# Vite inject style attributes; removing it needs build-time nonces). connect-src
	# 'self' also covers same-origin wss:// (the SPA builds wss:// + location.host) and
	# nothing else, so an XSS cannot open a WebSocket to an attacker's host.
	# frame-src 'self' — Admin → API Docs iframes same-origin /api/docs.
	@notdocs not path /api/docs* /api/redoc*
	header @notdocs Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"

	# Request-size ceilings at the edge (the backend still enforces per-route caps).
	# Non-multipart: JSON, and the upload-session chunks (raw application/octet-stream,
	# at most 8 MiB each; evidence/uploads.py CHUNK_SIZE) — 10 MiB.
	# Multipart: the largest app cap is 512 MiB (legacy evidence + photo multipart,
	# collection output, the web-history file pair; artifacts/PCAP/forensic 500 MiB);
	# 520 MiB leaves 8 MiB for multipart framing and form fields (OD-4, was 2200 MiB).
	@not_multipart not header Content-Type multipart/form-data*
	request_body @not_multipart {
		max_size 10MiB
	}
	request_body {
		max_size 520MiB
	}

	# An over-limit body gets the API's JSON error shape instead of an empty 413
	# (OD-4 / R141). The CSP set above carries over; the baseline block is deferred
	# (it deletes Server), so it doesn't reach an error response: re-add it.
	handle_errors 413 {
		import security_baseline
		header Content-Type "application/json"
		respond `{"detail":"Request body too large","code":"file_too_large"}` 413
	}

	handle /api/docs* {
		import csp_api_docs
		reverse_proxy https://backend:8000 {
			import backend_mtls
		}
	}
	handle /api/redoc* {
		import csp_api_docs
		reverse_proxy https://backend:8000 {
			import backend_mtls
		}
	}

	# WebSockets: stream frames immediately.
	handle /api/warroom/ws/* {
		reverse_proxy https://backend:8000 {
			import backend_mtls
			flush_interval -1
		}
	}
	handle /api/notifications/ws {
		reverse_proxy https://backend:8000 {
			import backend_mtls
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy https://backend:8000 {
			import backend_mtls
		}
	}

	# SPA: the dedicated frontend container (nginx static) owns SPA fallback + caching.
	handle {
		reverse_proxy frontend:3000
	}

	# Access log → stdout (rotated by the Docker json-file driver), not next to the
	# TLS/ACME keys in /data. JSON, with the `token` query parameter deleted from the
	# logged URI (one-time working-copy links; see the global `log default`).
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				delete token
			}
		}
	}
}

# Plain HTTP only ever redirects. (ACME HTTP-01 challenges are answered by Caddy
# on this port before the redirect.)
:80 {
	redir https://{host}{uri} permanent
}
