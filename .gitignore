.env
.env.*
!.env.example
# Service secrets (scripts/secrets.sh) — never commit
/secrets/

# Certs (generated locally, never committed)
certs/*.crt
certs/*.key
certs/*.csr
certs/*.srl
# Local CA private key — kept OUT of ./certs (which is mounted into Caddy)
/ca/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
dist/
.vite/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Misc
/ignore
/docs
CLAUDE.md

# Local revert log (working notes, not committed)
REVERT.md
TODO.md
# Supply-chain scan output (scripts/scan.sh)
/scan-reports/
