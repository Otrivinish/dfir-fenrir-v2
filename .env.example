# ─────────────────────────────────────────────────────────────────────────────
# DFIR-FENRIR v2 — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — NOT in this file ────────────────────────────────────────────────
# Every service secret (Postgres + Redis passwords, SECRET_KEY, EVIDENCE_KEK,
# AUDIT_SIGNING_KEY, the worker token, a DuckDNS token) lives in ./secrets/<name>
# and reaches only the containers that need it, as a file under /run/secrets.
# `./setup.sh` (or `scripts/secrets.sh --apply`) generates them. Keep them out of
# this file: a value here would override the secret file inside the container.
# ./secrets/evidence_kek is IRREPLACEABLE — back it up offline (password manager).

# ── TLS / Domain ──────────────────────────────────────────────────────────────
# The edge serves ONLY https://$DOMAIN, TLS 1.3 only (Windows 10 / Server 2019
# PowerShell and curl.exe can't do TLS 1.3 — use a browser or a newer host).
# DOMAIN is the exact name (or IP) users type; other Host names get no site.
#
# TLS_MODE picks the certificate source (`auto` = first mode whose inputs exist):
#   selfsigned  DOMAIN=localhost or the server's LAN IP; ./generate-certs.sh (setup.sh
#               runs it) makes certs/ — import certs/ca.crt into your browser.
#   acme        Internet-reachable public DNS name → Let's Encrypt (80+443 reachable):
#                 DOMAIN=fenrir.example.org  LETSENCRYPT_EMAIL=you@example.org
#   duckdns     DuckDNS name → Let's Encrypt via DNS-01 (port 80 not required):
#                 DOMAIN=yourname.duckdns.org  LETSENCRYPT_EMAIL=…  DUCKDNS_TOKEN=…
#   byo         Your own certificate, placed in certs/:
#                 TLS_CERT_FILE=/certs/server.crt  TLS_KEY_FILE=/certs/server.key
#   internal    Caddy's built-in self-signed CA.
#
TLS_MODE=auto
DOMAIN=localhost
LETSENCRYPT_EMAIL=
# DuckDNS token: put it in ./secrets/duckdns_token (not here).
TLS_CERT_FILE=
TLS_KEY_FILE=

# ── Network access ────────────────────────────────────────────────────────────
# Leave blank to follow DOMAIN (recommended): CORS_ORIGINS=https://$DOMAIN and
# ALLOWED_HOSTS=$DOMAIN. Only set them to list extra names deliberately.
CORS_ORIGINS=
ALLOWED_HOSTS=

# ── Backup encryption (age) ──────────────────────────────────────────────────
# Public key ("age1…") that every DB dump is encrypted to. Generate the key pair
# OFFLINE — `age-keygen -o fenrir-backup.agekey` on another machine — keep the
# key file in your password manager (restore: scripts/restore.sh --identity …),
# and put ONLY the printed public key here. Unset = dumps are NOT encrypted.
BACKUP_AGE_RECIPIENT=

# ── Auth policy ──────────────────────────────────────────────────────────────
# TOTP_REQUIRED=true  → first-run admin + admin-created users are forced
#                       through TOTP enrolment before reaching the app.
# TOTP_REQUIRED=false → TOTP becomes opt-in. Users enrol from Settings
#                       (or the /totp/enrol route) on their own schedule.
# Default = true. Leave on unless you have a specific reason. Disabling 2FA
# materially weakens the security posture of a DFIR platform.
TOTP_REQUIRED=true

# Browser session idle timeout (minutes). Sessions are revoked after this
# many minutes without a request, even though session_ttl_seconds (8h hard
# cap) hasn't elapsed. Tighten for higher-sensitivity deployments; loosen
# only with deliberate tradeoff against stolen-cookie window.
INACTIVITY_TIMEOUT_MINUTES=30
